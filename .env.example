# ---- Client (Vite; must be prefixed with VITE_) ----
# WebSocket URL of the game server. Leave empty to force offline practice mode.
# Local dev: ws://localhost:8787   Production: wss://<your-cloud-run-service>.run.app
VITE_SERVER_URL=ws://localhost:8787

# ---- Server ----
# Port the game server listens on (Cloud Run sets PORT automatically).
PORT=8787
# Comma-separated list of allowed browser origins for WebSocket connections.
# Leave empty in local development to allow any origin.
ALLOWED_ORIGINS=https://shotdis.vercel.app
# Max players per room (humans + bots). Bots fill empty slots up to BOT_FILL.
ROOM_SIZE=8
BOT_FILL=4
# Set to 1 behind a reverse proxy (Cloud Run, Fly, nginx) so per-IP limits see the real client address.
TRUST_PROXY=0
# Abuse caps.
MAX_SESSIONS=400
MAX_ROOMS=48
MAX_PER_IP=6
